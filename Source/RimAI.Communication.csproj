<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
            RimWorld 1.7 and nothing older. 1.7 is not a Unity player: it runs on
            .NET 10, its assemblies sit in the game folder itself, and one
            assembly - UnityStubs - stands in for everything that was
            UnityEngine.*Module.dll. So this is net10.0 and compiles against that
            stand-in, which turns a Unity member 1.7 does not have into a compile
            error here instead of a type that fails to load there. The 1.6 build
            is the tag rimworld-1.6-final.
        -->
        <GameVersion Condition=" '$(GameVersion)' == '' ">1.7</GameVersion>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <!-- The game loads a mod assembly from the mod's own folder: no deps
             file and no runtime config beside it. -->
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
        <HarmonyLibVersion Condition=" '$(HarmonyLibVersion)' == '' ">3.0.0-rc.2</HarmonyLibVersion>
        <RootNamespace>Ustas.RimAI.Communication</RootNamespace>
        <AssemblyName>RimAI.Communication</AssemblyName>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

        <RimWorldDir Condition=" '$(RimWorldDir)' == '' ">$(RIMWORLD_DIR)</RimWorldDir>
        <RimWorldWorkshopDir Condition=" '$(RimWorldWorkshopDir)' == '' ">$(RIMWORLD_WORKSHOP_DIR)</RimWorldWorkshopDir>
        <BaseOutputPath Condition=" '$(BaseOutputPath)' == '' ">$(LOCALAPPDATA)\Ustas\RimWorldSourceBuilds\RimAI.Communication\bin\</BaseOutputPath>
        <BaseIntermediateOutputPath Condition=" '$(BaseIntermediateOutputPath)' == '' ">$(LOCALAPPDATA)\Ustas\RimWorldSourceBuilds\RimAI.Communication\obj\</BaseIntermediateOutputPath>

        <OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>
        <ModFolderName>RimAI.Communication</ModFolderName>
        <ModRoot>$(MSBuildProjectDirectory)\..</ModRoot>
        <LangVersion>latest</LangVersion>
        <EnableBubbles>true</EnableBubbles>
    </PropertyGroup>

    <!--
        Interaction Bubbles is compiled against, and it can be in either of two
        places: our fork under the game's Mods folder, or the Workshop item it
        was forked from. Adopting it moves the mod from the second to the first,
        and a path naming only the Workshop number turns that into eight failed
        builds with nothing in their own sources changed.

        With neither present, EnableBubbles turns itself off and BubblePatch.cs
        leaves the compile - the switch was already there for exactly this and
        only lacked a way to notice.
    -->
    <PropertyGroup>
        <BubblesForkPath>$(RimWorldDir)\Mods\Interaction Bubbles\1.7\Assemblies\Bubbles.dll</BubblesForkPath>
        <!-- Until the Bubbles fork itself has moved to its 1.7 folder. -->
        <BubblesForkPath Condition=" !Exists('$(BubblesForkPath)') ">$(RimWorldDir)\Mods\Interaction Bubbles\1.6\Assemblies\Bubbles.dll</BubblesForkPath>
        <BubblesWorkshopPath>$(RimWorldWorkshopDir)\1516158345\Assemblies\Bubbles.dll</BubblesWorkshopPath>
        <BubblesPath Condition=" '$(BubblesPath)' == '' And Exists('$(BubblesForkPath)') ">$(BubblesForkPath)</BubblesPath>
        <BubblesPath Condition=" '$(BubblesPath)' == '' And Exists('$(BubblesWorkshopPath)') ">$(BubblesWorkshopPath)</BubblesPath>
        <EnableBubbles Condition=" '$(BubblesPath)' == '' ">false</EnableBubbles>
    </PropertyGroup>

    <!-- Define version constants based on GameVersion -->
    <PropertyGroup>
        <DefineConstants>$(DefineConstants);V$(GameVersion.Replace('.', '_'))</DefineConstants>
    </PropertyGroup>

    <!-- Release build configuration -->
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <Optimize>false</Optimize>
        <DebugSymbols>true</DebugSymbols>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    </PropertyGroup>

    <ItemGroup>
        <!-- Compiled against, never shipped: the Harmony mod is where the one
             library everybody is patched through comes from. Harmony 3 is the
             first with an asset for .NET 10, and the version is the one that
             mod deploys. -->
        <PackageReference Include="Lib.Harmony" Version="$(HarmonyLibVersion)" ExcludeAssets="runtime" PrivateAssets="All" />
        <ProjectReference Include="..\..\RimAI.Core\src\RimAI.Core\RimAI.Core.csproj">
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>

    <!-- Use reference assemblies by default (for other users and CI) -->
    <ItemGroup Condition=" '$(UseLocalDlls)' != 'true' ">
        <!-- Core RimWorld & UnityEngine libraries -->
        <PackageReference Include="Krafs.Rimworld.Ref" Version="$(GameVersion).*-*" PrivateAssets="All" />
    </ItemGroup>

    <!-- Reference actual game assemblies when UseLocalDlls is enabled -->
    <ItemGroup Condition=" '$(UseLocalDlls)' == 'true' AND '$(RimWorldDir)' != '' ">
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityStubs">
            <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Waylith">
            <HintPath>$(RimWorldDir)\Waylith.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- Remove BubblePatch.cs when bubble is disabled -->
    <ItemGroup Condition=" '$(EnableBubbles)' == 'false' ">
        <Compile Remove="Patches/BubblePatch.cs"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="../tests/**/*.cs" />
    </ItemGroup>

    <!-- Include External Libraries -->
    <ItemGroup>
        <Reference Include="Bubbles" Condition=" '$(EnableBubbles)' == 'true' ">
            <HintPath>$(BubblesPath)</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Scriban">
            <HintPath>$(ModRoot)\Libs\Scriban.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <!-- Deploy to RimWorld client -->
    <Target Name="DeployToModsFolder" AfterTargets="Build" Condition=" '$(BuildingWithScript)' != 'true' AND '$(RimWorldDir)' != '' ">
        <CallTarget Targets="WinDeploy" Condition=" '$(OS)' == 'Windows_NT' "/>
        <CallTarget Targets="MacDeploy" Condition=" '$(OS)' != 'Windows_NT' "/>
    </Target>

    <!-- Deploy to RimWorld client (macOS) -->
    <Target Name="MacDeploy" DependsOnTargets="StageModAssemblies">
        <PropertyGroup>
            <DeployPath>$(RimWorldDir)/RimWorldMac.app/Mods/$(ModFolderName)/</DeployPath>
        </PropertyGroup>
        <MakeDir Directories="$(DeployPath)"/>
        <Exec Command='rsync -a --delete --checksum "$(ModRoot)/About/"     "$(DeployPath)About/"'/>
        <Exec Command='rsync -a --delete --checksum "$(ModRoot)/Defs/"      "$(DeployPath)Defs/"'/>
        <Exec Command='rsync -a --delete --checksum "$(ModRoot)/Languages/" "$(DeployPath)Languages/"'/>
        <Exec Command='rsync -a --delete --checksum "$(ModRoot)/Textures/"  "$(DeployPath)Textures/"'/>
        <Exec Command='rsync -a --delete --checksum "$(ModRoot)/$(GameVersion)/"       "$(DeployPath)$(GameVersion)/"'/>
        <Message Text="--- macOS deployment finished successfully ---" Importance="high"/>
    </Target>

    <!-- Stage primary + private deps into versioned Assemblies before MIR (Assemblies is not source-owned). -->
    <Target Name="StageModAssemblies">
        <MakeDir Directories="$(ModRoot)\$(GameVersion)\Assemblies" />
        <ItemGroup>
            <_StagedAssemblies Include="$(TargetPath)" />
            <_StagedAssemblies Include="$(ModRoot)\Libs\Scriban.dll" Condition="Exists('$(ModRoot)\Libs\Scriban.dll')" />
        </ItemGroup>
        <Copy SourceFiles="@(_StagedAssemblies)" DestinationFolder="$(ModRoot)\$(GameVersion)\Assemblies\" SkipUnchangedFiles="true" />
    </Target>

    <!-- Deploy to RimWorld client (Windows) -->
    <Target Name="WinDeploy" DependsOnTargets="StageModAssemblies">
        <PropertyGroup>
            <WinModPath>$(RimWorldDir)\Mods\$(ModFolderName)\</WinModPath>
        </PropertyGroup>
        <Message Text="Copying to $(WinModPath)" Importance="high"/>
        <ItemGroup>
            <_CopyDirs Include="About;Defs;Languages;Textures;$(GameVersion)"/>
        </ItemGroup>
        <MakeDir Directories="$(WinModPath)"/>
        <Exec Command='robocopy "$(ModRoot)\About"     "$(WinModPath)About" /MIR' IgnoreExitCode="true"/>
        <Exec Command='robocopy "$(ModRoot)\Defs"      "$(WinModPath)Defs" /MIR' IgnoreExitCode="true"/>
        <Exec Command='robocopy "$(ModRoot)\Languages" "$(WinModPath)Languages" /MIR' IgnoreExitCode="true"/>
        <Exec Command='robocopy "$(ModRoot)\Textures"  "$(WinModPath)Textures" /MIR' IgnoreExitCode="true"/>
        <Exec Command='robocopy "$(ModRoot)\$(GameVersion)"       "$(WinModPath)$(GameVersion)" /MIR' IgnoreExitCode="true"/>
        <Message Text="--- Windows deployment finished successfully ---" Importance="high"/>
    </Target>

</Project>


